# DataPilot-Agent optional environment overrides (prefix: DPA_)
# Copy to .env if you want to customize local runtime paths or Agent guardrails.

# Directory for SQLite metadata DB (datapilot.db), materialized DuckDB files & uploads
# DPA_RUNTIME_DIR=./runtime

# Query & upload limits
# DPA_MAX_UPLOAD_MB=200
# DPA_MAX_RESULT_ROWS=1000
# DPA_PREVIEW_ROWS=50
# DPA_QUERY_TIMEOUT_SEC=30

# Default ReAct Agent budget guardrails
# DPA_DEFAULT_MAX_STEPS=8
# DPA_DEFAULT_MAX_SQL_RUNS=6
